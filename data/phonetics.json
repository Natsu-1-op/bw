  "entries": {
    "sound/L1mp3/L1(5)1.mp3": {
      "title": "h 声母：何・紅",
      "focus": "h",
      "examples": [
        {
          "text": "何",
          "jyutping": "ho4",
          "mandarin": "hé"
        },
        {
          "text": "紅",
          "jyutping": "hung4",
          "mandarin": "hóng"
        }
      ],
      "note": "对照两种语言的 h 声母；粤语 h 发音部位靠近喉部。",
      "authorship": "本页补注"
    },
    "sound/L1mp3/L1(5)2.mp3": {
      "title": "ng 声母：我・眼・硬",
      "focus": "ng",
      "examples": [
        {
          "text": "我",
          "jyutping": "ngo5"
        },
        {
          "text": "眼",
          "jyutping": "ngaan5"
        },
        {
          "text": "硬",
          "jyutping": "ngaang6"
        }
      ],
      "note": "留意开头的 ng，是舌根鼻音；ng 作为整体发音。",
      "authorship": "本页补注"
    },
    "sound/L1mp3/L1(5)3.mp3": {
      "title": "圆唇声母：怪・貴・誇・困",
      "focus": "gw / kw",
      "examples": [
        {
          "text": "怪",
          "jyutping": "gwaai3"
        },
        {
          "text": "貴",
          "jyutping": "gwai3"
        },
        {
          "text": "誇",
          "jyutping": "kwaa1"
        },
        {
          "text": "困",
          "jyutping": "kwan3"
        }
      ],
      "note": "gw、kw 发音时嘴唇收圆；同时留意 aa 与 a 的长短区别。",
      "authorship": "本页补注"
    },
    "sound/L2mp3/L2(5)1.mp3": {
      "title": "同音对照：詩人・私人等",
      "focus": "z / c / s",
      "examples": [
        {
          "text": "詩人",
          "jyutping": "si1 jan4",
          "mandarin": "shī rén"
        },
        {
          "text": "私人",
          "jyutping": "si1 jan4",
          "mandarin": "sī rén"
        },
        {
          "text": "魚翅",
          "jyutping": "jyu4 ci3",
          "mandarin": "yú chì"
        },
        {
          "text": "魚刺",
          "jyutping": "jyu4 ci3",
          "mandarin": "yú cì"
        },
        {
          "text": "治理",
          "jyutping": "zi6 lei5",
          "mandarin": "zhì lǐ"
        },
        {
          "text": "自理",
          "jyutping": "zi6 lei5",
          "mandarin": "zì lǐ"
        },
        {
          "text": "酒後",
          "jyutping": "zau2 hau6",
          "mandarin": "jiǔ hòu"
        },
        {
          "text": "走後",
          "jyutping": "zau2 hau6",
          "mandarin": "zǒu hòu"
        }
      ],
      "note": "每两个词是一组对照。粤拼中同写第 1 声的音，在不同口音里可有高平、高降的差别。",
      "authorship": "本页补注"
    },
    "sound/L2mp3/L2(5)2.mp3": {
      "title": "声母对照：基・奇・希・居・區・虛",
      "focus": "g / k / h",
      "examples": [
        {
          "text": "基",
          "jyutping": "gei1",
          "mandarin": "jī"
